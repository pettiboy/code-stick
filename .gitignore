# --- OS & editors ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/

# --- Secrets & local env (never commit) ---
.env
.env.*
!.env.example
*.pem

# --- Node / JS (mobile-app and any future packages) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Expo / React Native (also covered by mobile-app/.gitignore) ---
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# --- PlatformIO / embedded (hardware-code-stick) ---
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.clang_complete
.gcc-flags.json

# Signing & keystores (mobile native)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
